# RuamLem Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3030
FRONTEND_URL=http://localhost:3000
RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Logging
LOG_LEVEL=debug

# Debug Mode
DEBUG=true

# Supabase service role key: FOR OPERATOR SCRIPTS ON YOUR OWN MACHINE ONLY (ai:reindex, ai:recheck,
# ai:moderation-eval). It bypasses row level security. NEVER set it on the production server (Render): the server
# runs every request as the signed-in user and works without it. Leave this blank in any deployed environment.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI features
# Kill switches: with both false the site behaves exactly as before.
AI_ENABLED=false
AI_MODERATION_ENABLED=false

# Azure OpenAI, v1 endpoint: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment names (not model names) of the chat and embedding deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Azure AI Content Safety (used by AI moderation)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Messages per user per day for Ask RuamLem, counted in the database (table ai_usage, sql/005), so it survives
# restarts. A per-instance in-memory counter also guards against bursts. Default 50.
AI_DAILY_LIMIT_PER_USER=50

# Optional: Ask RuamLem tokens per user per day (prompt + reply + embedding). 0 or empty means no token limit.
AI_DAILY_TOKEN_LIMIT_PER_USER=0

# Prices for the AI usage dashboard's estimated cost, per MILLION tokens, in the currency below. Leave empty to
# show tokens only. Changing a price re-prices all history, because cost is computed when the page is opened.
# Look the numbers up on your Azure price sheet for the deployed models.
AI_PRICE_CURRENCY=USD
AI_PRICE_CHAT_INPUT_PER_MTOK=
AI_PRICE_CHAT_OUTPUT_PER_MTOK=
AI_PRICE_EMBEDDING_PER_MTOK=

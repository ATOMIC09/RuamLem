# RuamLem Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3030
FRONTEND_URL=http://localhost:3000
RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Logging
LOG_LEVEL=debug

# Debug Mode
DEBUG=true

# Supabase service role key (server-side only, never expose to the browser).
# Used for data, storage and the auth admin API, and by the AI features for post_embeddings and
# moderation_log, which RLS hides from everyone else. It bypasses row level security, so set it where
# the backend runs (for example on Render) BEFORE applying sql/003_database_hardening.sql.
# Without it the backend falls back to the anon key and works as before, but RLS cannot be turned on.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI features
# Kill switches: with both false the site behaves exactly as before.
AI_ENABLED=false
AI_MODERATION_ENABLED=false

# Azure OpenAI, v1 endpoint: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment names (not model names) of the chat and embedding deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# Azure AI Content Safety (used by AI moderation)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Questions per user per day for Ask RuamLem (counted in memory, per server instance)
AI_DAILY_LIMIT_PER_USER=20

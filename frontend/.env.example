# Backend base URL
NEXT_PUBLIC_API_URL=http://localhost:3030

# RSA public key used to encrypt sign-in and sign-up payloads (must match the backend's private key)
NEXT_PUBLIC_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# Shows the "Ask RuamLem" page and its navbar link. Keep false to behave exactly as before.
NEXT_PUBLIC_AI_ENABLED=false
